{
  "system": {
    "name": "AI Label OCR System",
    "version": "1.0.0",
    "description": "Clean Architecture & Repository Pattern OCR System with TypeScript, Tesseract.js, and Microsoft SQL Server",
    "technologyStack": {
      "language": "TypeScript (Node.js 22+)",
      "framework": "Express.js",
      "ocrEngine": "Tesseract.js (Offline Local OCR)",
      "database": "Microsoft SQL Server (mssql)",
      "orm": "TypeORM (Repository Pattern)",
      "validation": "Zod",
      "diagramTool": "Archify"
    }
  },
  "architecture": {
    "pattern": "Clean Architecture / Hexagonal / Repository Pattern",
    "layers": [
      {
        "id": "presentation",
        "name": "Presentation / Interface Layer",
        "components": [
          { "id": "http_server", "name": "Express HTTP Server", "type": "Server" },
          { "id": "label_ctrl", "name": "LabelController", "type": "Controller" },
          { "id": "upload_mw", "name": "Multer Upload Middleware", "type": "Middleware" },
          { "id": "error_mw", "name": "Global Error Middleware", "type": "Middleware" }
        ]
      },
      {
        "id": "application",
        "name": "Application Layer",
        "components": [
          { "id": "scan_service", "name": "LabelScanService", "type": "Service", "role": "Orchestrates OCR, parsing, database persistence, and audit logging" },
          { "id": "label_dtos", "name": "DTOs & Validation", "type": "DTO", "role": "Defines input/output contracts and Zod schema validation" }
        ]
      },
      {
        "id": "domain",
        "name": "Domain Layer",
        "components": [
          { "id": "label_entity", "name": "Label Entity", "type": "Entity", "role": "Core business model for scanned labels" },
          { "id": "scan_log_entity", "name": "ScanLog Entity", "type": "Entity", "role": "Audit trail for OCR execution metrics" },
          { "id": "ilabel_repo", "name": "ILabelRepository", "type": "Interface", "role": "Repository contract for Label persistence" },
          { "id": "iscanlog_repo", "name": "IScanLogRepository", "type": "Interface", "role": "Repository contract for ScanLog persistence" }
        ]
      },
      {
        "id": "infrastructure",
        "name": "Infrastructure Layer",
        "components": [
          { "id": "tesseract_service", "name": "TesseractOCRService", "type": "OCR Engine", "role": "Offline optical character recognition worker" },
          { "id": "parser_service", "name": "LabelParserService", "type": "Parser", "role": "Extracts barcode, lot, dates, product names, weight via regex heuristics" },
          { "id": "typeorm_label_repo", "name": "TypeORMLabelRepository", "type": "Repository", "role": "Concrete TypeORM repository implementing ILabelRepository" },
          { "id": "typeorm_log_repo", "name": "TypeORMScanLogRepository", "type": "Repository", "role": "Concrete TypeORM repository implementing IScanLogRepository" },
          { "id": "mssql_db", "name": "Microsoft SQL Server", "type": "Database", "role": "Relational storage for Labels and ScanLogs" }
        ]
      }
    ],
    "dataFlow": [
      {
        "step": 1,
        "from": "Client / Scanner",
        "to": "upload_mw",
        "action": "Upload label image (POST /api/v1/labels/scan)"
      },
      {
        "step": 2,
        "from": "upload_mw",
        "to": "label_ctrl",
        "action": "Forward uploaded file buffer/path"
      },
      {
        "step": 3,
        "from": "label_ctrl",
        "to": "scan_service",
        "action": "Invoke scanAndSaveLabel(filePath, options)"
      },
      {
        "step": 4,
        "from": "scan_service",
        "to": "tesseract_service",
        "action": "Execute OCR text extraction"
      },
      {
        "step": 5,
        "from": "tesseract_service",
        "to": "parser_service",
        "action": "Pass raw text and line confidence to parser"
      },
      {
        "step": 6,
        "from": "parser_service",
        "to": "scan_service",
        "action": "Return structured LabelParsedData"
      },
      {
        "step": 7,
        "from": "scan_service",
        "to": "typeorm_label_repo",
        "action": "Insert/Update Label record in SQL Server"
      },
      {
        "step": 8,
        "from": "scan_service",
        "to": "typeorm_log_repo",
        "action": "Record ScanLog with execution metrics"
      },
      {
        "step": 9,
        "from": "scan_service",
        "to": "label_ctrl",
        "action": "Return saved Label and extraction metadata"
      },
      {
        "step": 10,
        "from": "label_ctrl",
        "to": "Client / Scanner",
        "action": "HTTP 201 Response with structured JSON"
      }
    ]
  }
}

